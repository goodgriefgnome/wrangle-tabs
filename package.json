{
  "name": "wrangle-tabs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that closes duplicate tabs and sorts the rest into tab groups.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.4"
  }
}
