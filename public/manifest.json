{
  "manifest_version": 3,
  "name": "Wrangle Tabs",
  "version": "0.1.0",
  "description": "Close duplicate tabs and sort the rest into tab groups, from one keyboard-driven page.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "tabGroups", "storage", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Wrangle tabs"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open the Wrangle Tabs dashboard"
    }
  }
}
